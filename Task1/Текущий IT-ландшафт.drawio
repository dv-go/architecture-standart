        <mxCell id="DV_Fb4hNzOWSLJzFKm_V-176" value="Система кол-центра" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
