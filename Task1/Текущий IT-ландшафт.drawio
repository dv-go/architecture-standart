        <mxCell id="DV_Fb4hNzOWSLJzFKm_V-178" value="СМС-шлюз телеком-оператора" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="270" y="170" width="187" height="73" as="geometry" />
        </mxCell>
        <mxCell id="DV_Fb4hNzOWSLJzFKm_V-179" value="Телеком-оператор (внеш.сист)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f7ed;fillStyle=auto;strokeColor=#36393d;" parent="1" vertex="1">
          <mxGeometry x="270" y="228" width="87" height="70" as="geometry" />
